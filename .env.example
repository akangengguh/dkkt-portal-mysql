# Memory fallback cocok untuk uji coba satu instance. Untuk produksi, gunakan Redis/Upstash.
RATE_LIMIT_ALLOW_MEMORY_FALLBACK=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local upload cocok untuk uji coba. Untuk file penting/jangka panjang, gunakan object storage.
UPLOAD_STORAGE_DRIVER=local
UPLOAD_STORAGE_BASE_URL=
UPLOAD_STORAGE_BUCKET=
UPLOAD_STORAGE_REGION=
UPLOAD_STORAGE_ENDPOINT=
UPLOAD_STORAGE_ACCESS_KEY_ID=
UPLOAD_STORAGE_SECRET_ACCESS_KEY=
